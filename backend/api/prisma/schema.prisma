generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  }

model Aluno {
  id        Int      @id @default(autoincrement())
  nome      String
  email     String   @unique
  telefone  String?
  treinos   Treino[]
}

model Professor {
  id            Int     @id @default(autoincrement())
  nome          String
  email         String  @unique
  especialidade String?
  treinos       Treino[]
}

model Equipamento {
  id        Int        @id @default(autoincrement())
  nome      String
  tipo      String
  exercicios Exercicio[]
}

model Exercicio {
  id             Int          @id @default(autoincrement())
  nome           String
  grupoMuscular  String
  equipamentoId  Int
  equipamento    Equipamento  @relation(fields: [equipamentoId], references: [id])
  treinos        TreinoExercicio[]
}

model Treino {
  id          Int       @id @default(autoincrement())
  nome        String
  objetivo    String
  alunoId     Int
  professorId Int

  aluno       Aluno     @relation(fields: [alunoId], references: [id])
  professor   Professor @relation(fields: [professorId], references: [id])
  exercicios  TreinoExercicio[]
}

model TreinoExercicio {
  id           Int      @id @default(autoincrement())
  treinoId     Int
  exercicioId  Int
  series       Int
  repeticoes   Int
  carga        Float?
  descanso     Int?
  observacao   String?
  ordem        Int?

  treino       Treino   @relation(fields: [treinoId], references: [id])
  exercicio    Exercicio @relation(fields: [exercicioId], references: [id])
}
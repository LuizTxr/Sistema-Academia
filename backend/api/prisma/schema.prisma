generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Aluno {
  id        Int      @id @default(autoincrement())
  matricula String   @unique
  nome      String
  email     String   @unique
  telefone  String?
  treinos   Treino[]
}

model Professor {
  id            Int      @id @default(autoincrement())
  nome          String
  email         String   @unique
  especialidade String?
  treinos       Treino[]
}

model Equipamento {
  id         Int         @id @default(autoincrement())
  nome       String      @unique
  tipo       String
  exercicios Exercicio[]
}

model Exercicio {
  id            Int               @id @default(autoincrement())
  nome          String            @unique
  grupoMuscular String
  equipamentoId Int
  equipamento   Equipamento       @relation(fields: [equipamentoId], references: [id])
  treinos       TreinoExercicio[]
}

model Treino {
  id          Int               @id @default(autoincrement())
  nome        String
  diaSemana   String
  ativo       Boolean           @default(true)
  professorId Int
  alunoId     Int
  objetivo    String
  aluno       Aluno             @relation(fields: [alunoId], references: [id])
  professor   Professor         @relation(fields: [professorId], references: [id])
  exercicios  TreinoExercicio[]
}

model TreinoExercicio {
  treinoId    Int
  exercicioId Int
  series      Int
  repeticoes  Int
  carga       Float?
  descanso    Int?
  id          Int       @id @default(autoincrement())
  observacao  String?
  ordem       Int?
  exercicio   Exercicio @relation(fields: [exercicioId], references: [id])
  treino      Treino    @relation(fields: [treinoId], references: [id])
}

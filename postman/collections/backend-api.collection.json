  "item": [
    {
      "name": "Aluno Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"matricula\": \"1001\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/auth/aluno/login",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "auth",
            "aluno",
            "login"
          ]
        }
      }
    },
    {
      "name": "Aluno Treinos",
      "request": {
        "method": "GET",

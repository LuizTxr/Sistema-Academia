          "host": [
            "{{base_url}}"
          ],
          "path": [
            "alunos",
            "1001",
            "treinos"
          ]
        }
      }
    },
    {
      "name": "Professor Listar Treinos",
      "request": {
        "method": "GET",
        "header": [
